{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "create-block/carmo-category-product",
  "version": "0.1.31",
  "title": "Carmo Category Product",
  "category": "widgets",
  "icon": "slides",
  "description": "Carousel de produtos WooCommerce por categoria ou com produtos escolhidos à mão, com número de colunas configurável para desktop e mobile.",
  "example": {},
  "attributes": {
    "source": {
      "type": "string",
      "enum": [
        "category",
        "handpicked"
      ],
      "default": "category"
    },
    "productIds": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": []
    },
    "customTitle": {
      "type": "string",
      "default": ""
    },
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "eyebrowClass": {
      "type": "string",
      "default": ""
    },
    "categoryId": {
      "type": "number",
      "default": 0
    },
    "columnsDesktop": {
      "type": "number",
      "default": 4
    },
    "columnsMobile": {
      "type": "number",
      "default": 2
    },
    "productsToShow": {
      "type": "number",
      "default": 8
    },
    "excerptLength": {
      "type": "number",
      "default": 80
    },
    "titleTag": {
      "type": "string",
      "default": "h2"
    },
    "cardsAlign": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "left"
    },
    "titleUppercase": {
      "type": "boolean",
      "default": false
    },
    "hideViewCartLink": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "textdomain": "carmo-category-product",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}